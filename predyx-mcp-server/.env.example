# Predyx MCP Server 环境配置

# 服务器配置
MCP_SERVER_NAME=Predyx Prediction Market Server
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_PORT=8000

# NWC 支付配置（等待 Steven 提供）
# NWC_CONN_STR=nostr+wallet+connect://...

# 商业模式配置
BASIC_FEATURES_FREE=true
ADVANCED_FEATURES_PRICE=10  # sats per call
PREMIUM_FEATURES_PRICE=50  # sats per call

# Predyx API 配置（未来使用）
# PREDYX_API_URL=https://beta.predyx.com
# PREDYX_API_KEY=your_api_key_here

# 缓存配置
CACHE_TTL=300  # 5 minutes
CACHE_ENABLED=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=predyx_mcp.log
