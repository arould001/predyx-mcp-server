# 增强版 Agent 环境变量配置模板
# 复制此文件为 .env，并填入实际值

# ==================== NWC 配置 ====================
# NWC 连接字符串（从 LNbits 获取）
# 格式：nostr+walletconnect://<pubkey>?relay=<relay_url>&secret=<secret>
NWC_CONNECTION_STRING=nostr+walletconnect://your_pubkey_here?relay=wss://relay.damus.io&secret=your_secret_here

# ==================== Nostr Relays ====================
# Nostr relay 列表（用逗号分隔）
NOSTR_RELAYS=wss://relay.damus.io,wss://nostr.wine,wss://relay.nostr.band

# ==================== LLM 配置 ====================
# LLM API 基础 URL（可选）
LLM_BASE_URL=https://api.openai.com/v1

# LLM API 密钥
LLM_API_KEY=your_api_key_here

# LLM 模型名称
LLM_MODEL_NAME=gpt-4

# ==================== Agent 配置 ====================
# Agent 名称
AGENT_NAME=Dia Enhanced Agent

# 收费标准（sats/msg）
AGENT_PRICE_SATS=10

# 是否启用 NostrRAG（true/false）
ENABLE_NOSTR_RAG=true

# 是否启用 DSPy（true/false）
ENABLE_DSPY=false

# ==================== 日志配置 ====================
# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/agent.log
